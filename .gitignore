# Python
__pycache__/
*.py[cod]

# Virtual environment
.venv/
venv/
env/

# User uploads
uploads/*
!uploads/.gitkeep

# Generated files
generated/*
!generated/.gitkeep

# Satellite / geospatial data (ignore root/temp TIFs, but preserve demo_data)
*.jp2
*.hdf
*.h5
!demo_data/**/*.tif
!demo_data/**/*.tiff
!demo_data/*.tif
!demo_data/*.tiff

# Model weights (ignore large downloads, but keep local lightweight RS adapter)
!models/checkpoints/**/*.pt
!models/checkpoints/**/*.json
*.pt
*.pth
*.ckpt
*.safetensors

# Secrets
.env
.env.*

# VS Code / OS
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log