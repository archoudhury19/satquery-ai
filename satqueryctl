#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$DIR/.env"

case "$1" in
    start)
        "$DIR/scripts/start_all.sh"
        ;;
    stop)
        "$DIR/scripts/stop_all.sh"
        ;;
    restart)
        "$DIR/scripts/restart_all.sh"
        ;;
    status)
        "$DIR/scripts/status.sh"
        ;;
    url)
        "$DIR/scripts/get_tunnel_url.sh"
        ;;
    set-discord)
        if [ -z "$2" ]; then
            echo "Usage: ./satqueryctl set-discord <DISCORD_WEBHOOK_URL>"
            exit 1
        fi
        echo "DISCORD_WEBHOOK_URL=\"$2\"" >> "$ENV_FILE"
        echo "[+] Discord Webhook configured! Sending test alert..."
        "$DIR/scripts/notify.sh" "Test Alert" "Discord webhook connected successfully to SatQuery AI!"
        ;;
    set-telegram)
        if [ -z "$2" ] || [ -z "$3" ]; then
            echo "Usage: ./satqueryctl set-telegram <TELEGRAM_BOT_TOKEN> <CHAT_ID>"
            exit 1
        fi
        echo "TELEGRAM_BOT_TOKEN=\"$2\"" >> "$ENV_FILE"
        echo "TELEGRAM_CHAT_ID=\"$3\"" >> "$ENV_FILE"
        echo "[+] Telegram Bot configured! Sending test alert..."
        "$DIR/scripts/notify.sh" "Test Alert" "Telegram bot connected successfully to SatQuery AI!"
        ;;
    test-alert)
        echo "[+] Sending test alert via configured notification channels..."
        "$DIR/scripts/notify.sh" "Manual Test Alert" "Everything is operating normally on the NVIDIA CUDA GPU server."
        echo "[+] Alert sent!"
        ;;
    set-token)
        if [ -z "$2" ]; then
            echo "Usage: ./satqueryctl set-token <CLOUDFLARE_TUNNEL_TOKEN>"
            exit 1
        fi
        echo "CLOUDFLARE_TUNNEL_TOKEN=\"$2\"" > "$ENV_FILE"
        echo "[+] Saved Cloudflare Tunnel Token to .env"
        echo "[+] Restarting tunnel service..."
        systemctl --user restart satquery-tunnel.service
        echo "[+] Cloudflare custom tunnel activated!"
        ;;
    clear-token)
        if [ -f "$ENV_FILE" ]; then
            rm -f "$ENV_FILE"
        fi
        echo "[+] Cleared custom tunnel credentials. Reverting to free Cloudflare Quick Tunnel..."
        systemctl --user restart satquery-tunnel.service
        sleep 3
        "$DIR/scripts/get_tunnel_url.sh"
        ;;
    gpu)
        "$DIR/scripts/check_gpu.sh"
        ;;
    test)
        echo "Running SatQuery full system verification test suite..."
        PYTHONPATH="$DIR" "$DIR/.venv/bin/python" "$DIR/tests/test_full_system.py"
        ;;
    logs)
        case "$2" in
            tunnel)
                journalctl --user -u satquery-tunnel.service -f
                ;;
            server|"")
                journalctl --user -u satquery.service -f
                ;;
            all)
                journalctl --user -u satquery.service -u satquery-tunnel.service -f
                ;;
        esac
        ;;
    *)
        echo "============================================================"
        echo "SatQuery AI Control Tool (satqueryctl)"
        echo "============================================================"
        echo "Usage: ./satqueryctl {start|stop|restart|status|url|set-discord|set-telegram|test-alert|gpu|test|logs}"
        echo ""
        echo "Commands:"
        echo "  start         - Enable and start 24/7 server and Tunnel"
        echo "  stop          - Stop 24/7 services"
        echo "  restart       - Restart 24/7 services"
        echo "  status        - Show complete health, GPU, and tunnel status"
        echo "  url           - Display active public HTTPS URL"
        echo "  set-discord   - Configure Discord Webhook notifications"
        echo "  set-telegram  - Configure Telegram Bot notifications"
        echo "  test-alert    - Send an instant test notification"
        echo "  gpu           - Run NVIDIA CUDA GPU diagnostics"
        echo "  test          - Run end-to-end multi-modal test suite on GPU"
        echo "  logs          - Tail service logs (logs, logs tunnel, logs all)"
        echo "============================================================"
        exit 1
        ;;
esac
